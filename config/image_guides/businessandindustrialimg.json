  "source": "FY27_Category_StyleGuide_Business-Industrial.pdf",
  "last_updated": "Sept 15, 2026",
  "status": "complete",
  "global_guidance": {
    "rules": [
      "imagery should have high appetite appeal",
      "silo images should be photographed consistently according to packaging or product type",
      "minimize reflections on plastic, foil, and shiny packaging, especially when covering important product information",
      "remove unnecessary stickers not part of package design, such as special promotion stickers or legal declarations",
      "packaging and labels should be presented straight, not angled or crooked",
      "photograph each unique and meaningful side of the product package",
      "for round or irregular shapes, present sides so printed information and graphics are centered and legible",
      "front view is the side with predominant brand and labeling, format, variant, and size/quantity",
      "products should be evenly lit from side to side and top to bottom",
      "exposure and color should correctly represent the item",
      "maintain separation between product and background",
      "clip products onto pure white background, RGB 255/255/255",
      "retouch dirt, dust, fingerprints, damage, blemishes, expiration dates, lot numbers, and sample-only information",
      "lifestyle images should be realistic, professionally lit, and styled appropriately to the item and brand",
      "product being sold should remain the hero of the lifestyle image",
      "packaging should be incorporated into lifestyle images when practical to connect lifestyle images to silo shots",
      "items must display all indicated required images and conditionally required images and meet the minimum image count listed on each page",
      "maintain details in product whites and avoid flare or spill from the background",
      "when possible, photograph the item without packaging and digitally apply artwork or labels for a clean, legible final image",
      "use sharp focus on the featured product; softer background or foreground focus and white space may simplify the image",
      "when the product and its packaging appear together, both must be in focus so packaging can be identified and read",
      "maintain a consistent visual approach and consistent angles across the assortment for a unified PDP and shelf presentation",
      "individual brand guidelines should take precedence"
    ]
  },
  "slot_definitions": {
    "main_image": {
      "label": "Main Image",
      "description": "Primary carousel image/hero image for the PDP.",
      "detection_hints": [
        "main",
        "hero",
        "primary",
        "front",
        "image 1",
        "carousel 1"
      ]
    },
    "silo_front": {
      "label": "Silo, Front",
      "guidance": "Show the entire item straight-on on a pure white background. Lab instruments and labware should be out of package; industrial components and facilities equipment may be photographed at an angle.",
      "recommendation": "Add a front silo image on pure white following the angle and packaging direction for the product section.",
      "detection_hints": [
        "front",
        "silo",
        "main",
        "hero",
        "white background",
        "out of package"
      ]
    },
    "lifestyle_in_use": {
      "label": "Lifestyle, In-Use",
      "guidance": "Show the product in a lifestyle setting that aligns with the brand.",
      "recommendation": "Add a lifestyle image showing the product in use in a setting that aligns with the brand.",
      "detection_hints": [
        "lifestyle",
        "in-use",
        "in use",
        "setting",
        "application"
      ]
    },
    "feature_graphic": {
      "label": "Feature Graphic",
      "guidance": "Highlight a product feature or benefit using supporting text and graphics.",
      "recommendation": "Add a feature graphic highlighting a product feature or benefit with supporting text and graphics.",
      "detection_hints": [
        "feature",
        "benefit",
        "callout",
        "graphic",
        "supporting text"
      ]
    },
    "silo_detail": {
      "label": "Silo, Detail",
      "guidance": "Show a close-up of a key design detail to highlight quality.",
      "recommendation": "Add a close-up silo image showing a key design detail and product quality.",
      "detection_hints": [
        "detail",
        "close-up",
        "close up",
        "design",
        "quality"
      ]
    },
    "dimensions": {
      "label": "Dimensions",
      "guidance": "Use a scale avatar or apply product dimensions to the front-of-pack image.",
      "recommendation": "Add a scale avatar or dimensions graphic applied to the front-of-pack image.",
      "detection_hints": [
        "dimensions",
        "scale avatar",
        "height",
        "width",
        "depth",
        "measurements",
        "size"
      ]
    },
    "silo_alternate": {
      "label": "Silo, Alternate",
      "guidance": "Capture an alternate angle of the product.",
      "recommendation": "Add an alternate-angle silo image of the product.",
      "detection_hints": [
        "alternate",
        "alternate angle",
        "side",
        "back",
        "rear"
      ]
    },
    "silo_out_of_pack_whats_included": {
      "label": "Silo, Out of Pack, What's Included",
      "guidance": "Show all kit components in a clean flat-lay on a white background with every item visible.",
      "recommendation": "Add an out-of-pack flat-lay on white showing all kit components with every item visible.",
